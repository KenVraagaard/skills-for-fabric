# Normalize line endings to avoid CRLF/LF churn on Windows clones.
# Without this, files checked out on Windows can show every line as
# "changed" in git diff (the whole-repo phantom diff). Renormalize once
# after adding this file:  git add --renormalize . && git commit

# Treat everything as text and normalize to LF in the repository.
* text=auto eol=lf

# Documentation and source — always LF.
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.sql  text eol=lf
*.ipynb text eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.xlsx binary
*.pptx binary
*.docx binary
